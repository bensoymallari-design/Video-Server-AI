# Copy to .env in the repository root. Never commit .env.
# All variables use the QUBIT_ prefix.

# Required for stable sessions. Use a long random value.
QUBIT_SECRET_KEY=replace-with-a-random-string

# First-run administrator. Used only when the database has no users.
# Changing these later does not update an existing account.
QUBIT_ADMIN_USERNAME=admin
QUBIT_ADMIN_PASSWORD=replace-with-a-password-of-at-least-8-characters

# Listen address. Keep the loopback default unless you have put a
# authenticated reverse proxy in front of the API.
QUBIT_HOST=127.0.0.1
QUBIT_PORT=8000

QUBIT_LOG_LEVEL=INFO
QUBIT_TOKEN_TTL_HOURS=12
QUBIT_MAX_UPLOAD_BYTES=2147483648

# Comma-separated browser origins allowed to call the API directly.
QUBIT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# SQLite is the Phase 1 database. A postgres URL is rejected until a driver is added.
# QUBIT_DATABASE_URL=sqlite:///./data/qubit.db
# QUBIT_MEDIA_DIR=./data/media
# QUBIT_DATA_DIR=./data
